# Rust / Cargo
/target/
**/target/
Cargo.lock.bak

# Tauri
src-tauri/gen/
src-tauri/target/

# Node / frontend (ui)
node_modules/
.next/
out/
dist/
*.tsbuildinfo
.npm/
.pnpm-store/

# Compiled engine binaries (we version the pin, not the binaries)
engine/bin/
# The helper's deploy context: ~110 MB of engine binaries assembled out of band before
# `railway up`. `deploy/helper/README.md` has said since August that this is "not in git", and it
# was true only because nobody had run `git add -A` while it existed. Staging a deploy today made
# it show up as untracked, which is one keystroke from committing the whole engine.
deploy/helper/bin/

# Secrets and local state - NEVER version
# (key shares, seeds, vault config, sensitive data)
*.key
*.share
*.seed
secrets/
.env
.env.*
!.env.example

# Local app state (SQLite, sync cache)
*.sqlite
*.sqlite-*
*.db

# Internal product/planning docs - kept on disk, not published
docs/CONCEITO_INICIAL.md
docs/UX_E_FLUXOS.md
docs/LOGICA_E_REGRAS.md
docs/HANDOFF.md

# Local working folder (analyses, plans, notes) - never version
/temp/

# Internal security audit log - kept private until findings are fixed
SECURITY_AUDIT.md

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp
*~

# Logs
*.log
logs/
.vercel
.env*

# Claude Code local state stays out, but project skills are versioned.
# NOTE: must exclude the CONTENTS (.claude/*), not the directory (.claude/),
# or git never descends into it and the negation below has no effect.
.claude/*
!.claude/skills/
